# PowerContext Server 配置（本作品用：Dify 的跨会话记忆）
#
# 记忆库使用 PowerContext 默认的本地 SQLite：
# PowerContext 1.5.0 的 OceanBase 维护流程要求「MySQL 用户租户」，单机 seekdb 只有 sys 租户，
# 其 embedded seekdb 后端又不支持 Windows。作品里的 seekdb 职责因此集中在
# 「Dify 知识库的向量 + 全文混合检索」（见 README 的技术分工表）。
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8011
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=true
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
POWERCONTEXT_SERVER_METRICS_ENABLED=false
POWERCONTEXT_HOME=D:\code\oceanbase\run\pc-home
