# ============================================================================
# 离谱侦探社：本地运行配置示例（复制成 .env 再改）
# 所有值都是占位符；真实的 API Key / 密码只写进你自己的 .env，不要提交。
# ============================================================================

# ---- Dify（本作品按官方 Docker Compose 部署，端口映射到宿主机 18080）----
DIFY_URL=http://127.0.0.1:18080
DIFY_ADMIN_EMAIL=detective@example.com
DIFY_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# ---- 大模型（OpenAI 兼容 / DeepSeek 官方插件）----
# Dify 里用 langgenius/deepseek 插件，模型 deepseek-flash；换成别家时同步改 LLM_PROVIDER/LLM_MODEL
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_MODEL_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_PROVIDER=langgenius/deepseek/deepseek
LLM_MODEL=deepseek-flash

# ---- Embedding（本地 ONNX 服务，见 scripts/download_embedding_model.py）----
# Dify 容器内访问宿主机用 host.docker.internal；Embedding 模型名要与 dify 里配置的一致
EMBED_BASE_URL=http://host.docker.internal:8013/v1
EMBED_API_KEY=local-embed
EMBED_MODEL=bge-small-zh-v1.5
EMBED_PORT=8013

# ---- 侦探社后端（Dify 的 HTTP Request 节点调用它）----
DETECTIVE_BASE_URL=http://host.docker.internal:8012
DETECTIVE_PORT=8012
# 两个密钥都要 16 位以上，且必须与 Dify DSL 里的环境变量 DETECTIVE_API_KEY 一致
DETECTIVE_API_KEY=REPLACE_WITH_DETECTIVE_API_KEY
DETECTIVE_SIGNING_KEY=REPLACE_WITH_DETECTIVE_SIGNING_KEY

# ---- PowerContext（跨会话记忆；本作品用它的 HTTP Memory API）----
POWERCONTEXT_URL=http://127.0.0.1:8011
POWERCONTEXT_HTTP_PORT=8011
# 启用鉴权时（POWERCONTEXT_SERVER_ACCESS_MODE=enforced）填这里
POWERCONTEXT_TOKEN=

# ---- seekdb（Dify 知识库的向量 + 全文存储）----
# 与 docker/docker-compose.yaml 里 seekdb 服务一致
OCEANBASE_VECTOR_HOST=host.docker.internal
OCEANBASE_VECTOR_PORT=2886
OCEANBASE_VECTOR_USER=root
OCEANBASE_VECTOR_PASSWORD=REPLACE_WITH_SEEKDB_PASSWORD
OCEANBASE_VECTOR_DATABASE=test
OCEANBASE_ENABLE_HYBRID_SEARCH=true
OCEANBASE_FULLTEXT_PARSER=ngram
